# Copier ce fichier en .env et ne jamais committer .env (voir .gitignore)

POSTGRES_USER=appuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=rando

# Host = "db" quand l'API tourne DANS docker-compose (c'est notre cas, on reste sur Docker).
DATABASE_URL=postgresql://appuser:devpassword@db:5432/rando

REDIS_URL=redis://redis:6379/0